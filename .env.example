# Copy this file to .env and fill in your own values.
# NEVER commit your real .env - it contains full account access.

# --- Telegram (required) ---
# Get these from https://my.telegram.org -> API Development Tools
API_ID=
API_HASH=

# Genshin UID(s) the bot reports on. UID2 is optional (used by !switch to
# toggle between two accounts); if you only have one account, leave UID2 blank.
UID1=
UID2=

# Run generate_session.py once locally to produce this, then paste the
# result here. This lets the bot log in without an interactive prompt on
# your host, and survives a redeploy/container rebuild.
SESSION_STRING=

# --- HoYoLAB (required for !abyss, !stygian, !theater, !note) ---
# Log into https://www.hoyolab.com in a browser, open dev tools -> Application
# -> Cookies, and copy these two values.
LTUID_V2=
LTOKEN_V2=

# Only set this to "cn" if you play on a Miyoushe (China) account instead of
# overseas HoYoLAB. Leave blank/unset otherwise.
HOYOLAB_REGION=
